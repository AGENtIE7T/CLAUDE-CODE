# ── Supabase ─────────────────────────────────────────────────────────────
# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only — NEVER expose. Used by workers / server actions with elevated rights.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── LLM (content generation + fact-check) ───────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
AEO_MODEL="claude-sonnet-5"

# ── AI visibility measurement ───────────────────────────────────────────────
# Used by the visibility probe to measure share-of-voice across answer engines.
AHREFS_API_TOKEN=""
SEMRUSH_API_KEY=""

# ── Billing ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Demo mode ────────────────────────────────────────────────────────────────
# Runs the whole app with seeded in-memory data and no external services.
# Turns on automatically when NEXT_PUBLIC_SUPABASE_URL is unset; force with "1".
NEXT_PUBLIC_DEMO_MODE="1"

# ── SEO Command Center ───────────────────────────────────────────────────────
# A separate product that lives alongside AEO Autopilot in this app.
# Production writes (CMS edits, redirects, robots.txt, outreach email) stay
# DISABLED until this is explicitly set to "1". Default OFF = audit/preview only.
SEO_ENABLE_PRODUCTION_WRITES="0"
# Real (non-demo) network crawling of verified domains. Default OFF.
SEO_ENABLE_LIVE_CRAWL="0"
# 32-byte base64 key used to envelope-encrypt connection credentials at rest.
# Generate with: openssl rand -base64 32   (server-only; NEVER expose.)
SEO_CREDENTIALS_ENC_KEY=""

# ── WordPress connection (SEO Command Center) ────────────────────────────────
# Server-only. Never sent to the browser, never returned by an API response,
# never written to the audit log. Leave BLANK until a staging site exists —
# with no base URL the adapter reports "not connected" and every write path
# refuses rather than pretending to have succeeded.
#
# Site root, no trailing slash and no /wp-json (e.g. https://staging.example.com).
WORDPRESS_BASE_URL=""
# WordPress username the Application Password belongs to.
WORDPRESS_USERNAME=""
# An Application Password (Users → Profile → Application Passwords), NOT the
# account password. Revoke it in wp-admin to instantly cut this app's access.
WORDPRESS_APP_PASSWORD=""
# "staging" | "production". A connection marked mock can never be used against
# production, and production additionally requires SEO_ENABLE_PRODUCTION_WRITES=1.
WORDPRESS_ENVIRONMENT="staging"
# "read_only" | "read_write". Start read_only; raise it only after a verified
# preview → approve → execute cycle has run against staging.
WORDPRESS_ACCESS="read_only"
# Set to "1" to run the whole product against the in-process FIXTURE WordPress
# instead of a real site. Every change is simulated and clearly labelled MOCK
# in the UI. A mock connection can never be used against production — that is
# enforced in code (assertUsable), not by this flag.
WORDPRESS_USE_MOCK="0"

# ── Background jobs ──────────────────────────────────────────────────────────
# Shared secret for the scheduled worker at /api/jobs/run. Without it the
# endpoint refuses every request rather than defaulting to open.
# Generate with: openssl rand -hex 32   (server-only; NEVER expose.)
CRON_SECRET=""
