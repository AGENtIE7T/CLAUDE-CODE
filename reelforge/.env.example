# Required. Server-side only; never exposed to the browser.
ANTHROPIC_API_KEY=

# Optional. Model used for generator, critic, hooks and learnings calls.
REELFORGE_MODEL=claude-sonnet-5-5

# Optional. Effort level for model calls: low | medium | high. Lower = faster/cheaper.
REELFORGE_EFFORT=medium

# Optional. Max generations per IP per hour (in-memory limiter).
REELFORGE_RATE_LIMIT_PER_HOUR=10
